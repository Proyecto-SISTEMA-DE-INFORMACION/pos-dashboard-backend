# ── Base de datos (PostgreSQL 16) ─────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=botilleria
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=botilleria

# ── Seguridad ─────────────────────────────────────────────
# Mínimo 32 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Horas que dura la sesión antes de pedir login de nuevo
TOKEN_HORAS=12

# ── Frontend que puede llamar a la API (separa varios con comas)
FRONTEND_ORIGINS=http://localhost:3000

# ── Asistente IA (Gemini) ─────────────────────────────────
# Clave gratuita en Google AI Studio
AI_API_KEY=
AI_MODEL=gemini-3.5-flash
AI_MAX_HISTORIAL=20
AI_TIMEOUT_SEGUNDOS=60

# ── Otros ─────────────────────────────────────────────────
ZONA_HORARIA=America/Santiago
MAX_MB_ARCHIVO=20
